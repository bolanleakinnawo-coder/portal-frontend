# Development (npm run dev): "/" sends API calls through the Vite proxy in vite.config.js (avoids CORS).
VITE_API_URL=/

# backend = applicants sign up / log in with the real backend; staff and demo users are local.
# demo    = everything local (no backend needed, e.g. for a presentation without internet).
VITE_AUTH_MODE=backend

# Show the demo accounts box on the sign-in page (set to false before going live).
VITE_SHOW_DEMO_ACCOUNTS=true

# Email notifications through EmailJS (optional). Without these, emails are only kept in the Email Log.
# Template variables: {{to_email}} {{to_name}} {{subject}} {{message}} {{link}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE=
